generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TabSet {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  htmlCode  String
  jsCode    String
}

model EscapeRoom {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  title           String
  description     String?
  backgroundImage String
  timerSeconds    Int      @default(300)
  puzzles         Json
}

model GameProgress {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  roomId       String?
  currentStage Int      @default(0)
  timeLeft     Int      @default(300)
}
